<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>AMDAutoTuning</AssemblyName>
    <RootNamespace>AMDAutoTuning</RootNamespace>
    <Version>1.2.2</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <FileVersion>1.2.2.0</FileVersion>
    <Company>EFF5 Automações Inteligentes</Company>
    <Authors>EFF5 Automações Inteligentes</Authors>
    <Product>AMD AutoTuning &amp; Optimizer</Product>
    <AssemblyTitle>AMD AutoTuning &amp; Optimizer</AssemblyTitle>
    <Description>Otimizador e Auditor de Desempenho para AMD Ryzen e Radeon</Description>
    <Copyright>Copyright © 2026 EFF5 Automações Inteligentes (eff5.com.br)</Copyright>
    <PackageProjectUrl>https://eff5.com.br</PackageProjectUrl>
    <RepositoryUrl>https://github.com/escti/AMD_autotuning</RepositoryUrl>

    <!-- Single File Packaging Properties -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

</Project>
