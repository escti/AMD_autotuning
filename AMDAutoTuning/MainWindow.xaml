<Window x:Class="AMDAutoTuning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AMDAutoTuning"
        mc:Ignorable="d"
        Title="AMD AutoTuning &amp; Optimizer - ESCTI" 
        Height="820" Width="1120"
        MinHeight="700" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0E1015"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Custom ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#151821"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Rounded Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#252A36"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333A4A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#16A34A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22C55E"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#15803D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TitleBar Buttons -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252A36"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Ambient Accent -->
        <Border BorderBrush="#1F2430" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" /> <!-- Custom Title Bar -->
                    <RowDefinition Height="Auto" /> <!-- Header & Quick Actions -->
                    <RowDefinition Height="Auto" /> <!-- Hardware Overview Cards -->
                    <RowDefinition Height="*" />    <!-- Main Diagnostic Items List -->
                    <RowDefinition Height="Auto" /> <!-- Console Log / Status Footer -->
                </Grid.RowDefinitions>

                <!-- ROW 0: Title Bar -->
                <Grid Grid.Row="0" Background="#12151D">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="⚡" FontSize="16" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="AMD AutoTuning &amp; Optimizer" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Border Background="#252A36" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ESCTI Edition v1.0" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons (Non-Client Area) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="─" Click="MinimizeButton_Click" ToolTip="Minimizar"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="□" Click="MaximizeButton_Click" ToolTip="Maximizar"/>
                        <!-- Close Button with custom Hover red -->
                        <Button Content="✕" Click="CloseButton_Click" ToolTip="Fechar">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#DC2626"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ROW 1: Header Banner & Actions -->
                <Border Grid.Row="1" Background="#161922" BorderBrush="#202533" BorderThickness="0,0,0,1" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Auditoria &amp; Otimização de Performance" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Diagnóstico profundo de BIOS, Resizable BAR, agendamento AMD CPPC e ajustes de latência." 
                                       FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Global Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}" 
                                    Margin="0,0,10,0" 
                                    Click="RescanButton_Click"
                                    ToolTip="Executar nova auditoria completa do hardware">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" Margin="0,0,6,0"/>
                                    <TextBlock Text="Re-analisar"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SuccessButtonStyle}" 
                                    Click="OptimizeAllButton_Click"
                                    ToolTip="Aplica plano equilibrado, fixa pagefile em 8GB e otimiza rede em 1 clique">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="Otimizar Tudo Seguro (1-Clique)"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 2: Hardware Summary Cards -->
                <Border Grid.Row="2" Background="#11131A" Padding="20,14" BorderBrush="#1D222E" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU CARD -->
                        <Border Grid.Column="0" Background="#1A1E29" BorderBrush="#272D3D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖥️" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="PROCESSADOR" FontSize="10" FontWeight="Bold" Foreground="#EF4444"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtCpuName" Text="{Binding CpuName}" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtCpuCores" Text="{Binding CpuCores}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- GPU CARD -->
                        <Border Grid.Column="1" Background="#1A1E29" BorderBrush="#272D3D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="4,0,4,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎮" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="PLACA DE VÍDEO" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtGpuName" Text="{Binding GpuName}" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtGpuDriver" Text="{Binding GpuDriver}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- RAM CARD -->
                        <Border Grid.Column="2" Background="#1A1E29" BorderBrush="#272D3D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="4,0,4,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="MEMÓRIA RAM" FontSize="10" FontWeight="Bold" Foreground="#FACC15"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtRamSummary" Text="{Binding RamSummary}" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtRamSpeed" Text="{Binding RamSpeed}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- MOTHERBOARD & BIOS CARD -->
                        <Border Grid.Column="3" Background="#1A1E29" BorderBrush="#272D3D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="8,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖴" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="PLACA-MÃE &amp; BIOS" FontSize="10" FontWeight="Bold" Foreground="#4ADE80"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtMotherboard" Text="{Binding Motherboard}" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtBiosVersion" Text="{Binding BiosVersion}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ROW 3: Diagnostic Cards List -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,12">
                    <ItemsControl x:Name="ItemsDiagnosticList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#161922" BorderBrush="#222836" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Information Column -->
                                        <StackPanel Grid.Column="0">
                                            <!-- Category and Status Badge -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding StatusIcon}" Foreground="White" FontWeight="Bold" FontSize="10" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold" FontSize="9"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Title -->
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>

                                            <!-- Values Row -->
                                            <Grid Margin="0,6,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Estado Atual: " FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CurrentValue}" FontSize="12" Foreground="#E2E8F0"/>
                                            </Grid>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Action Button Column -->
                                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Button Style="{StaticResource ActionButtonStyle}" 
                                                    Content="{Binding ActionLabel}"
                                                    Tag="{Binding ActionKey}"
                                                    Click="DiagnosticActionButton_Click"
                                                    Visibility="{Binding HasAction, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ROW 4: Console Log Footer -->
                <Border Grid.Row="4" Background="#0F1117" BorderBrush="#1C212D" BorderThickness="0,1,0,0" Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LOG DE OPERAÇÕES:" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtLogStatus" Text="Pronto. Todos os componentes analisados com sucesso." FontSize="10" Foreground="#38BDF8" Margin="8,0,0,0"/>
                        </StackPanel>

                        <TextBox Grid.Row="1" x:Name="TxtConsoleLog" 
                                 Background="#0A0C10" Foreground="#A5B4FC" BorderBrush="#1E2330" BorderThickness="1"
                                 FontFamily="Consolas" FontSize="11" 
                                 Height="75" Margin="0,6,0,0"
                                 IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- INSTRUCTION MODAL POPUP OVERLAY -->
        <Grid x:Name="ModalOverlay" Background="#B0000000" Visibility="Collapsed">
            <Border Background="#161A24" BorderBrush="#333D52" BorderThickness="1" CornerRadius="10" 
                    Width="680" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="TxtModalTitle" Text="Instruções Detalhadas" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Rectangle Height="1" Fill="#273042" Margin="0,10,0,12"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtModalBody" 
                                 Background="#0E1117" Foreground="#E2E8F0" BorderBrush="#252D3D" BorderThickness="1"
                                 FontFamily="Consolas" FontSize="12" Padding="12"
                                 IsReadOnly="True" TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="📋 Copiar Guia" Margin="0,0,10,0" Click="CopyModalButton_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Fechar" Width="90" Click="CloseModalButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
